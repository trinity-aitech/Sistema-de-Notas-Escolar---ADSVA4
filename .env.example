# ==========================================================
# CONFIGURAÇÕES DE BANCO DE DADOS (POSTGRESQL OU SUPABASE)
# ==========================================================

# Opção 1: PostgreSQL Local ou Docker
DB_URL=jdbc:postgresql://localhost:5432/escola_db
DB_USER=postgres
DB_PASSWORD=postgrespassword
SERVER_PORT=8080

# Opção 2: Supabase (obtenha em Project Settings -> Database -> Connection String)
# Se usar Direct Connection (porta 5432):
# DB_URL=jdbc:postgresql://db.YOUR_PROJECT_REF.supabase.co:5432/postgres?sslmode=require
# DB_USER=postgres
# DB_PASSWORD=YOUR_SUPABASE_PASSWORD

# Se usar Supabase Connection Pooler (porta 6543 - recomendado para alta concorrência):
# DB_URL=jdbc:postgresql://aws-0-sa-east-1.pooler.supabase.com:6543/postgres?sslmode=require
# DB_USER=postgres.YOUR_PROJECT_REF
# DB_PASSWORD=YOUR_SUPABASE_PASSWORD

# Configuração do Frontend (Vercel / Supabase Web)
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
